# Copy to .env (gitignored). gym and the reproduction scripts load it; variables already set in
# the shell win.

# =============================================================================
# Model backend for every role (agent, optimizer, LLM judges, tool-internal models).
#   langchain  providers' own APIs (OpenAI / Azure OpenAI / Anthropic / Gemini / Fireworks); default
#   uipath     UiPath LLM Gateway (needs the LLMGW_* / UIPATH_* credentials below)
# Also settable per run: --model_backend on the testbed and the optimizer.
# =============================================================================
AGENTS_GYM_LLM_BACKEND="langchain"

# --- langchain backend: OpenAI-compatible models ------------------------------
# Azure OpenAI wins when both of its variables are set; the model name must be a deployment
# name on your resource.
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com/"
# AZURE_OPENAI_API_VERSION="2025-03-01-preview"
#
# Otherwise the OpenAI API. OPENAI_BASE_URL sends every OpenAI client (system model, judges,
# embeddings) to an OpenAI-compatible server instead.
# OPENAI_API_KEY=""
# OPENAI_BASE_URL="http://localhost:8000/v1"
#
# A self-hosted system model (vLLM, a Fireworks deployment) next to OpenAI's judges and
# embeddings: model names no registry knows go to this endpoint, the rest keep their clients.
# AGENTS_GYM_MODEL_BASE_URL="http://localhost:8000/v1"
# AGENTS_GYM_MODEL_API_KEY=""

# --- langchain backend: other providers ---------------------------------------
# ANTHROPIC_API_KEY=""
# GOOGLE_API_KEY=""
# FIREWORKS_API_KEY=""   # Fireworks models
# Qwen3.5-9B as --models Qwen/Qwen3.5-9B (thinking off), on your own vLLM server or a hosted
# OpenAI-compatible endpoint (Fireworks: https://api.fireworks.ai/inference/v1, its model name
# and FIREWORKS_API_KEY's value as the key):
# QWEN_9B_VLLM_BASE_URL="http://localhost:8002/v1"
# QWEN_9B_VLLM_MODEL="Qwen/Qwen3.5-9B"   # the server's --served-model-name, or the provider's name
# QWEN_9B_VLLM_API_KEY=""                # if the endpoint requires one
# QWEN_9B_VLLM_MAX_CONCURRENCY="50"      # requests per second to that endpoint
# Qwen3.5-122B-A10B behind AGENTS_GYM_MODEL_BASE_URL, for `gym reproduce self-opt-122b`:
# QWEN_122B_MODEL=""   # its model name on that endpoint
# DeepSeek-V4.1-Flash-1017 as --models deepseek-ai/DeepSeek-V4.1-Flash-1017, on your own
# OpenAI-compatible server or a hosted one:
# DEEPSEEK_V41_FLASH_VLLM_BASE_URL="http://localhost:8003/v1"
# DEEPSEEK_V41_FLASH_VLLM_MODEL="deepseek-ai/DeepSeek-V4.1-Flash-1017"   # the endpoint's model name
# DEEPSEEK_V41_FLASH_VLLM_API_KEY=""             # if the endpoint requires one
# DEEPSEEK_V41_FLASH_VLLM_THINKING="1"           # "0" turns thinking off
# DEEPSEEK_V41_FLASH_VLLM_MAX_CONCURRENCY="50"   # requests per second to that endpoint

# --- gym uipath run default model ----------------------------------------------
# Override the model used by `gym uipath run|eval` (SDK entry points) (default: gpt-4o-2024-11-20).
# The testbed and reproduction scripts use --models instead.
# GYM_DEFAULT_MODEL="gpt-4.1-mini-2025-04-14"

# --- uipath backend: UiPath LLM Gateway ---------------------------------------
# UIPATH_LLM_SERVICE="llmgateway"
# LLMGW_URL=""
# LLMGW_CLIENT_ID=""
# LLMGW_CLIENT_SECRET=""
# LLMGW_SEMANTIC_ORG_ID=""
# LLMGW_SEMANTIC_TENANT_ID=""
# LLMGW_REQUESTING_PRODUCT=""
# LLMGW_REQUESTING_FEATURE=""

# =============================================================================
# Optional overrides
# =============================================================================
# Extra model registrations, as comma-separated module:function hooks run before models resolve.
# AGENTS_GYM_MODEL_OVERRIDES="my_package.models:register"
# Eval (system-model) sampling; the run name's temp_<t> is this value.
# UIPATH_AGENTS_GYM_TEMPERATURE="1.0"
# A gepa-artifact checkout outside this repo.
# GEPA_ARTIFACT_DIR=""
