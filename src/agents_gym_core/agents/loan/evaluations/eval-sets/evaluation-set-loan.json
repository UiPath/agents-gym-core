          }
        },
        "loan_ToolCallArgsEvaluator": {
          "toolCalls": [
            {
              "name": "LoanAgent_ApplyUiBankLoan",
              "args": {
                "RequestorEmailAddress": "john.doe@example.com",
                "LoanAmount": 50000,
                "LoanTerm": 5,
                "Income": 75000,
                "Age": 35
              }
            },
            {
              "name": "LoanAgent_ModifyLoanContract",
              "args": {
                "SharepointFolderURL": "https://example.sharepoint.com/sites/loans/contracts",
                "InterestRate": 4,
                "LoanAmount": 50000,
                "BorrowerName": "John Doe",
                "BorrowerAddress": "123 Main St, Anytown, USA"
              }
            },
            {
              "name": "LoanAgent_SendSharepointDocumentViaDocuSign",
              "args": {
                "SharepointFileURL": "https://example.sharepoint.com/sites/loans/contracts/New_doc.pdf",
                "RecipientLegalName": "John Doe",
                "RecipientEmail": "john.doe@example.com"
              }
            }
          ]
        },
        "loan_LLMJudgeOutputEvaluator": {
          "expectedOutput": {
            "ExecutionDetails": "1. Received loan application request from John Doe. 2. Applied for a loan of $50,000 for 5 years, approved at 4% APR. 3. Searched Google for current interest rates (National Bank benchmark at 6.5%). 4. Modified the loan contract with 4% interest rate since it is lower than the benchmark. 5. Sent the contract document via DocuSign to john.doe@example.com."
          }
        }
      }
    },
